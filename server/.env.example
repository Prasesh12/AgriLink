# PostgreSQL connection string
DATABASE_URL="postgresql://user:password@localhost:5432/agrilink?schema=public"

# Server
PORT=4000
NODE_ENV=development

# Auth
JWT_SECRET="change-this-to-a-long-random-string"
JWT_EXPIRES_IN="1d"

# CORS - URL of the client app
CLIENT_URL="http://localhost:5173"

# Payment: "mock" lets the app run end-to-end without real Khalti keys
PAYMENT_MODE="mock"
KHALTI_SECRET_KEY=""
KHALTI_BASE_URL="https://dev.khalti.com/api/v2"

# SMS: "console" logs SMS to the server console instead of sending real messages
SMS_MODE="console"
